# Скопируйте в .env (docker compose подхватит автоматически)
# Без этих значений сайт работает в гостевом режиме, а вход через Google
# вернёт 501 и кнопка покажет «не настроено».

# Публичный адрес сайта — ровно тот, который открывает пользователь
PUBLIC_URL=http://localhost:8080

# Секрет для подписи сессий (любая длинная случайная строка)
SESSION_SECRET=change-me-to-a-long-random-string

# Google OAuth 2.0:
#   Google Cloud Console -> APIs & Services -> Credentials -> OAuth client (Web)
#   Authorized JavaScript origins:  http://localhost:8080
#   Authorized redirect URIs:       http://localhost:8080/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Jamendo API для космического радио (frontend-плеер, проксируется через backend)
# https://devportal.jamendo.com -> create application -> Client ID / Client Secret
JAMENDO_CLIENT_ID=
JAMENDO_CLIENT_SECRET=

# --- pre-launch gate ---------------------------------------------------------
# nginx прогоняет каждый запрос через backend /api/entry/auth (HTTP Basic).
# Пока оба значения заданы — на сайт заходить нельзя (только логин/пароль).
# Оставьте пустыми (или удалите строки), когда пора открывать сайт публично.
ENTRY_USER=
ENTRY_PASS=

# --- QA-панель ---------------------------------------------------------------
# Открывается только по ссылке вида /?qa=<QA_TOKEN>. Тот же токен нужен,
# чтобы /api/test/* и бесплатный бросок test=1 сработали. Пусто = всё выключено.
QA_TOKEN=
